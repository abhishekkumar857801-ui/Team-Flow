{
  "name": "teamflow-server",
  "version": "1.0.0",
  "description": "TeamFlow shared REST API (Express + MongoDB) used by both the React web app and the Flutter mobile app",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:memory": "node --watch scripts/dev-memory.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-permissions.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "socket.io-client": "^4.8.1"
  }
}
